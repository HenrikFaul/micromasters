<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/worldCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <TextView
        android:id="@+id/worldThumb"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:background="@drawable/bg_world_thumb"
        android:gravity="center"
        android:text="🍳"
        android:textSize="30sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/worldName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Konyha"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/worldLock"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="5dp"
                android:contentDescription="@string/locked"
                android:src="@drawable/ic_lock"
                android:visibility="gone" />

            <TextView
                android:id="@+id/worldStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1/10"
                android:textColor="@color/text_dim"
                android:textSize="13sp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/worldProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="6dp"
            android:max="10"
            android:progress="1"
            android:progressTint="@color/green"
            android:progressBackgroundTint="#FF12203F" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/worldAction"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_marginStart="10dp"
        android:minWidth="92dp"
        android:paddingHorizontal="12dp"
        android:text="@string/enter"
        android:textColor="#08240F"
        android:textSize="13sp"
        android:textStyle="bold"
        app:backgroundTint="@color/green"
        app:cornerRadius="22dp" />
</LinearLayout>
