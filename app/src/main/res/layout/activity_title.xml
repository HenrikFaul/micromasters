<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_title">

    <ImageButton
        android:id="@+id/titleSettings"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/settings"
        android:src="@drawable/ic_settings" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="32dp">

        <ImageView
            android:id="@+id/planet"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/app_icon" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:letterSpacing="0.06"
            android:text="MICRO"
            android:textColor="@color/gold"
            android:textSize="46sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-8dp"
            android:letterSpacing="0.04"
            android:text="MASTERS"
            android:textColor="@color/text_primary"
            android:textSize="46sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/title_tagline"
            android:textColor="@color/text_dim"
            android:textSize="15sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPlay"
            android:layout_width="240dp"
            android:layout_height="62dp"
            android:layout_marginTop="40dp"
            android:text="@string/title_play"
            android:textColor="#3A2400"
            android:textSize="20sp"
            android:textStyle="bold"
            app:backgroundTint="@color/gold"
            app:cornerRadius="31dp"
            app:icon="@drawable/ic_play"
            app:iconGravity="textStart"
            app:iconTint="#3A2400" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogin"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="240dp"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:text="@string/title_login"
            android:textColor="@color/text_primary" />

    </LinearLayout>
</FrameLayout>
