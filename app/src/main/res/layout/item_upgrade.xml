<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <FrameLayout
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:background="@drawable/bg_world_thumb"
        android:clipToOutline="true">

        <ImageView
            android:id="@+id/upImg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="3dp"
            android:contentDescription="@string/app_name"
            android:scaleType="fitCenter"
            android:visibility="gone" />

        <TextView
            android:id="@+id/upEmoji"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="🐜"
            android:textSize="24sp" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/upName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bányász"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/upSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Szint 1"
            android:textColor="@color/text_dim"
            android:textSize="13sp" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/upBtn"
        android:layout_width="wrap_content"
        android:layout_height="46dp"
        android:layout_marginStart="8dp"
        android:minWidth="96dp"
        android:paddingHorizontal="12dp"
        android:text="100"
        android:textColor="#08240F"
        android:textSize="14sp"
        android:textStyle="bold"
        app:backgroundTint="@color/green"
        app:cornerRadius="23dp"
        app:icon="@drawable/ic_coin"
        app:iconGravity="textStart"
        app:iconSize="18dp"
        app:iconTint="@null" />
</LinearLayout>
