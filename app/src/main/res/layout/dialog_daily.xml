<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="@string/daily_title"
        android:textColor="@color/gold"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/dailySub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="2dp"
        android:text="@string/daily_sub"
        android:textColor="@color/text_dim"
        android:textSize="14sp" />

    <GridLayout
        android:id="@+id/dailyGrid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:columnCount="4"
        android:useDefaultMargins="false" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnClaim"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_marginTop="20dp"
        android:text="@string/daily_claim"
        android:textColor="#08240F"
        android:textSize="18sp"
        android:textStyle="bold"
        app:backgroundTint="@color/green"
        app:cornerRadius="18dp" />
</LinearLayout>
